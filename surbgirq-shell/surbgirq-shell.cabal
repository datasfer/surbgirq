cabal-version:      3.0

name:           surbgirq-shell
version:        0.1.0.0
description:    Please see the README on GitHub at <https://github.com/arthurvard/surbgirq-shell#readme>
homepage:       https://github.com/arthurvard/surbgirq-shell#readme
bug-reports:    https://github.com/arthurvard/surbgirq-shell/issues
author:         Arthur Vardanyan
maintainer:     arthur@datasfer.com
copyright:      2019
license:        MIT
license-file:   LICENSE
build-type:     Simple
extra-source-files: README.md
                    ChangeLog.md

source-repository head
  type: git
  location: https://github.com/arthurvard/surbgirq-shell

library
  exposed-modules: Surbgirq.Shell.Types
                   Surbgirq.Shell.Scraper
                   Surbgirq.Shell.Theographic

                   Surbgirq.Shell.Store.SQLite.Selda
                   Surbgirq.Shell.Store.ParseFile
                   Surbgirq.Shell.Store.Neo4j
                   Surbgirq.Shell.Scraper.Scalpel
                   Surbgirq.Shell.Scraper.Hxt
                   Surbgirq.Shell.Scraper.Scalpel.BibleScraper
                   Surbgirq.Shell.Scraper.Scalpel.GrabarBibleScraper
                   Surbgirq.Shell.Scraper.Scalpel.Narek
                   Surbgirq.Shell.Scraper.Scalpel.Narek.XeranyanScraper
                   Surbgirq.Shell.Scraper.Scalpel.JupyterHtml.ZohrapScraper
                   Surbgirq.Shell.CSV.Generate
                   Surbgirq.Shell.Txt.PlainText
                   
                   Surbgirq.Shell.Theographic.JSON.Types
                   Surbgirq.Shell.Theographic.JSON.Converter    

                   Surbgirq.Shell.Theographic.CSV.Converter
                   Surbgirq.Shell.Theographic.CSV.Convert.Books  
                   Surbgirq.Shell.Theographic.CSV.Convert.Places
                   Surbgirq.Shell.Theographic.CSV.Convert.Events   
                   Surbgirq.Shell.Theographic.CSV.Convert.Periods   
                   Surbgirq.Shell.Theographic.CSV.Convert.Verses   
                   Surbgirq.Shell.Theographic.CSV.Convert.Persons   
                   Surbgirq.Shell.Theographic.CSV.Convert.PersonGroups   
                   Surbgirq.Shell.Theographic.CSV.Convert.Chapters   
                   Surbgirq.Shell.Theographic.CSV.Convert.Eastons   
                   Surbgirq.Shell.Theographic.CSV.Convert.Helpers     

                   Surbgirq.Shell.Theographic.CSV.Types
                   Surbgirq.Shell.Theographic.CSV.Types.Place    
                   Surbgirq.Shell.Theographic.CSV.Types.Period     
                   Surbgirq.Shell.Theographic.CSV.Types.Person     
                   Surbgirq.Shell.Theographic.CSV.Types.Event     
                   Surbgirq.Shell.Theographic.CSV.Types.PersonGroup     
                   Surbgirq.Shell.Theographic.CSV.Types.Easton     
                   Surbgirq.Shell.Theographic.CSV.Types.Chapter     
                   Surbgirq.Shell.Theographic.CSV.Types.Verse     
                   Surbgirq.Shell.Theographic.CSV.Types.Book     
                   Surbgirq.Shell.Theographic.CSV.Types.Token
                   
  other-modules: Paths_surbgirq_shell
                 Surbgirq.Shell.Types.Scripture
                 Surbgirq.Shell.Store.Types
                 Surbgirq.Shell.Theographic.CSV.Types.Testament     
                 Surbgirq.Shell.Theographic.CSV.Types.Helpers     
                 
  hs-source-dirs: src
  build-depends: base ^>=4.17.2.1
               , surbgirq-types
               , surbgirq-utils
               , text
               , aeson
               , common
               , optparse-applicative
               , directory
               , interpolatedstring-perl6
               , selda
               , selda-sqlite
               , filepath
               , mtl
               , stm
               , hashable
               , containers
               , unordered-containers
               , scalpel >= 0.6.0
               , hxt
               , HandsomeSoup
               , split
               , raw-strings-qq
               , regex-pcre
               , pcre-heavy
               , yaml
               , bytestring               
               , cassava
               , vector
               , SHA
               , cryptonite        
                      
  default-language: Haskell2010

executable surbgirq-shell
  main-is: Main.hs
  other-modules: Paths_surbgirq_shell
  hs-source-dirs: app
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends: base ^>=4.17.2.1
               , surbgirq-shell
               , surbgirq-types
               , common
               , text
               , aeson
               , optparse-applicative
               , directory
               , interpolatedstring-perl6
               , filepath
               , mtl
  default-language: Haskell2010

executable html-scraper
  main-is: Main.hs
  other-modules: Paths_surbgirq_shell
  hs-source-dirs: app/Scraper
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends: base ^>=4.17.2.1
               , surbgirq-shell
               , surbgirq-types
               , scalpel >= 0.6.0
               , hxt
               , HandsomeSoup
               , common
               , text
               , aeson
               , optparse-applicative
               -- , optparse-generic
               , directory
               , interpolatedstring-perl6
               , filepath
               , mtl
  default-language: Haskell2010



executable surbgirq-sqlite
  main-is: Main.hs
  other-modules: Paths_surbgirq_shell
  hs-source-dirs: app/SQLite
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends: base ^>=4.17.2.1
               , surbgirq-shell
               , surbgirq-types
               , common
               , text
               , aeson
               , optparse-applicative
               , directory
               , interpolatedstring-perl6
               , filepath
               , mtl
               , selda
               , selda-sqlite

  default-language: Haskell2010

test-suite surbgirq-shell-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules: Paths_surbgirq_shell
  hs-source-dirs: test
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends: base ^>=4.17.2.1
               , surbgirq-shell
  default-language: Haskell2010



executable theographic
  main-is: Main.hs
  other-modules: Paths_surbgirq_shell
  hs-source-dirs: app/Theographic
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends: base ^>=4.17.2.1
               , surbgirq-shell
               , surbgirq-types
               , optparse-applicative
               , directory
               , interpolatedstring-perl6
               , filepath
               , text
               , mtl
  default-language: Haskell2010
