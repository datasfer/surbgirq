cabal-version:      3.0
name:           surbgirq
version:        0.1.0.0
description:    Surbgirq REST API executables
homepage:       https://github.com/githubuser/surbgirq#readme
bug-reports:    https://github.com/githubuser/surbgirq/issues
author:         Arthur Vardanyan
maintainer:     artie.vard@gmail.com
copyright:      2019 Arthur Vardanyan
license:        MIT
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    ChangeLog.md

executable telegram-bot
  main-is: TelegramBot.hs
  other-modules:       Sigterm
                       Types.BotSettings
  hs-source-dirs: app, src
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends: base >= 4.17.2.1 && < 5
               , surbgirq-bot-telegram
               , unix
               , optparse-applicative   >= 0.14
               , aeson
               , common
               , text
  default-language: Haskell2010



executable verse-explorer
  main-is: Explorer.hs
  other-modules: Sigterm
                 Settings
                 Types.Settings
                 Types.Logger
                 Types
  build-depends: 
  hs-source-dirs: app, src
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends: base >= 4.17.2.1 && < 5
               , service
              -- , surbgirq-service
              -- , surbgirq-db
               , wai-middleware-static
               , wai-extra
               , warp
               , unix
               -- , katip
               -- , katip-elasticsearch
               , optparse-applicative   >= 0.14
               , aeson
               , common
               , text
  default-language: Haskell2010

