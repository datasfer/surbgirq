# Copy this file to .env (git-ignored) and fill it in. Before starting the bot or the verse explorer, load it
# into your shell from the repository folder:  set -a; . ./.env; set +a
# Neo4j's settings are in docker/.env.example.

# The bot's token from @BotFather, without the "bot" prefix. Required.
TELEGRAM_BOT_TOKEN=

# The webhook's secret token, which Telegram sends with every update once setWebhook has it (docs/bot.md); the
# bot answers 401 to a request without it. Required. 1 to 256 characters: letters, digits, _ and -.
# Make one with:  openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Optional. Each one overrides a default in surbgirq/config/bot-settings.yaml or verse-explorer.yaml.
# surbgirq-graph-api's root, without /api:
# GRAPH_API_URL=http://localhost:33010
# Where the bot's webhook server listens (behind a reverse proxy, keep 127.0.0.1):
# BOT_LISTEN_HOST=127.0.0.1
# BOT_LISTEN_PORT=5000
# The Telegram Bot API server: Telegram's own, or a local telegram-bot-api server:
# TELEGRAM_API_HOST=api.telegram.org
# TELEGRAM_API_PORT=443
# The text for a reference without a translation word, when the user hasn't chosen one. The built-in ones are
# public; the 1994 text (e1994-T) and Kheranyan's Narek (narek_xer-T) aren't, so set those for a private bot only:
# BOT_DEFAULT_BIBLE=v1805-T
# BOT_DEFAULT_NAREK=narekaci-T
# Where the verse explorer listens, its static files, and the Bible whose books its front page lists:
# EXPLORER_HOST=127.0.0.1
# EXPLORER_PORT=8009
# EXPLORER_STATIC_PATH=../surbgirq-web/verse-explorer/front/
# EXPLORER_DEFAULT_BIBLE=v1805-T
