cabal-version: 1.12

name:           surbgirq-utils
version:        0.1.0.0
description:    Please see the README on GitHub at <https://github.com/arthurvard/surbgirq-types#readme>
homepage:       https://github.com/arthurvard/surbgirq-types#readme
bug-reports:    https://github.com/arthurvard/surbgirq-types/issues
author:         Arthur Vardanyan
maintainer:     arthur@datasfer.com
copyright:      2019
license:        BSD3
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    ChangeLog.md

source-repository head
  type: git
  location: https://github.com/arthurvard/surbgirq-types

library
  hs-source-dirs: src
  exposed-modules: Surbgirq.Utils
  other-modules: Paths_surbgirq_utils
                 Surbgirq.Utils.Scripture.Helpers
                 Surbgirq.Utils.Scripture.Numerals
  build-depends: base >=4.7 && <5
               , surbgirq-types
               , common
               , aeson
               , text
               , containers
               , interpolatedstring-perl6


  default-language: Haskell2010


test-suite surbgirq-types-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules: Paths_surbgirq_types
  hs-source-dirs: test
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends: base >=4.7 && <5
               , surbgirq-types
  default-extensions: TemplateHaskell
                      OverloadedStrings
  default-language: Haskell2010