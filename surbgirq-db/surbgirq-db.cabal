cabal-version: 1.12

name:           surbgirq-db
version:        0.1.0.0
description:    Please see the README on GitHub at <https://github.com/arthurvard/surbgirq-db#readme>
homepage:       https://github.com/arthurvard/surbgirq
bug-reports:    https://github.com/arthurvard/surbgirq/issues
author:         Arthur Vardanyan
maintainer:     arthur@datasfer.com
copyright:      2019
license:        BSD3
license-file:   LICENSE
build-type:     Simple
extra-source-files: README.md
                    ChangeLog.md

source-repository head
  type: git
  location: https://github.com/arthurvard/surbgirq

library
  exposed-modules: Surbgirq.Neo4j
  other-modules: Paths_surbgirq_db
               , Surbgirq.Neo4j.Config
               , Surbgirq.Neo4j.Types
               , Surbgirq.Neo4j.Data
  hs-source-dirs: src
  build-depends: base >=4.7 && <5
               , surbgirq-types
               , containers
               , hasbolt >= 0.1.3.3
               , lens
               , mtl
               , text
               , data-default
               , common
  default-language: Haskell2010

executable surbgirq-db-exe
  main-is: Main.hs
  other-modules: Paths_surbgirq_db
  hs-source-dirs: app
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends: base >=4.7 && <5
               , surbgirq-db
               , surbgirq-types
               , data-default
               , hasbolt >= 0.1.3.3
               , text
               , aeson

  default-language: Haskell2010

test-suite surbgirq-db-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules: Paths_surbgirq_db
  hs-source-dirs: test
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends: base >=4.7 && <5
               , surbgirq-db
  default-language: Haskell2010
