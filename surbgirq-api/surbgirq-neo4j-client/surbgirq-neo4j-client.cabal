cabal-version:  >= 1.12
name:           surbgirq-neo4j-client
version:        0.1.0.0
description:    Rest API client for surbgira-neo4j local rest api
homepage:       https://github.com/arthurvard/surbgirq#readme
bug-reports:    https://github.com/arthur/surbgirq/issues
author:         Arthur Vardanyan
maintainer:     arthur@datasfer.com
copyright:      2020
license:        BSD3
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    ChangeLog.md
    README.md

source-repository head
  type: git
  location: https://github.com/arthurvard/surbgirq-api/surbgirq-neo4j-client

library
  exposed-modules: Surbgirq.API.GraphDBClient
  other-modules: Paths_surbgirq_neo4j_client
  hs-source-dirs: src
  build-depends: base >=4.7 && <5
               , bytestring
               , exceptions
               , http-client
               , interpolatedstring-perl6
               , mtl
               , servant
               , servant-lucid
               , servant-client      >= 0.16
               , servant-client-core >= 0.16
               , http-client-tls
               , text
               , surbgirq-api-instances
               , surbgirq-types
  default-language: Haskell2010

test-suite surbgirq-neo4j-client-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules: Paths_surbgirq_api_client
  hs-source-dirs: test
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends: base >=4.7 && <5
               , surbgirq-api-client
  default-language: Haskell2010

