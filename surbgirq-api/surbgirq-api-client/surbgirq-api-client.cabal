cabal-version:  3.0
name:           surbgirq-api-client
version:        0.1.0.0
description:    Rest API client for surbgira-api
homepage:       https://github.com/arthurvard/surbgirq#readme
bug-reports:    https://github.com/arthur/surbgirq/issues
author:         Arthur Vardanyan
maintainer:     artie.vard@gmail.com
copyright:      2020
license:        MIT
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    ChangeLog.md
    README.md

source-repository head
  type: git
  location: https://github.com/arthurvard/surbgirq-api

library
  exposed-modules: Surbgirq.API.Client
  other-modules: Paths_surbgirq_api_client
  hs-source-dirs: src
  build-depends: base >= 4.17.2.1 && < 5
               , bytestring
               , exceptions
               , http-client
               , interpolatedstring-perl6
               , mtl
               , servant
               , servant-client      >= 0.16
               , servant-client-core >= 0.16
               , http-client-tls
               , text
               , surbgirq-api
               , surbgirq-types
  default-language: Haskell2010

test-suite surbgirq-api-client-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules: Paths_surbgirq_api_client
  hs-source-dirs: test
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends: base >= 4.17.2.1 && < 5
               , surbgirq-api-client
  default-language: Haskell2010

