cabal-version:  3.0
name:           surbgirq-api-instances
version:        0.1.0.0
description:    REST API types and endpoint definitions
homepage:       https://github.com/arthurvard/surbgirq-api-instances#readme
bug-reports:    https://github.com/arthurvard/surbgirq-api-instances/issues
author:         Arthur Vardanyan
maintainer:     artie.vard@gmail.com
copyright:      2021
license:        MIT
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    ChangeLog.md

source-repository head
  type: git
  location: https://github.com/arthurvard/surbgirq

library
  exposed-modules: Surbgirq.API.Instances
  other-modules: Paths_surbgirq_api_instances
  hs-source-dirs: src
  build-depends: base ^>=4.17.2.1
               , servant
               , common
               , text
               , data-default
               , http-api-data
               , surbgirq-types
  default-language: Haskell2010

test-suite surbgirq-api-instances-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules: Paths_surbgirq_api
  hs-source-dirs: test
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends: base ^>=4.17.2.1
  default-language: Haskell2010
