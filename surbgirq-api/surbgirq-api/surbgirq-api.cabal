cabal-version:  >= 1.12
name:           surbgirq-api
version:        0.1.0.0
description:    REST API types and endpoint definitions
homepage:       https://github.com/arthurvard/surbgirq-api#readme
bug-reports:    https://github.com/arthurvard/surbgirq-api/issues
author:         Arthur Vardanyan
maintainer:     arthur@datasfer.com
copyright:      2019
license:        BSD3
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    ChangeLog.md

source-repository head
  type: git
  location: https://github.com/arthurvard/surbgirq-api

library
  exposed-modules: Surbgirq.API
  other-modules: Paths_surbgirq_api
                 Surbgirq.API.Rest
                 Surbgirq.API.WebSocket
                 Surbgirq.API.Types
                 Surbgirq.API.Instances
  hs-source-dirs: src
  build-depends: base >=4.7 && <5
               , surbgirq-types
               , servant
               , servant-websockets
               , common
               , text
               , data-default
               , http-api-data

  default-language: Haskell2010

test-suite surbgirq-api-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Paths_surbgirq_api
  hs-source-dirs:
      test
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , surbgirq-api
  default-language: Haskell2010
