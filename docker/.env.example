# Copy this file to docker/.env (git-ignored) and fill it in. Compose reads docker/.env by itself.

# Neo4j's initial user and password, written as neo4j/ followed by the password (8 characters or more).
# The API needs the same password (Neo4jConfig__Password in surbgirq-graph-api).
NEO4J_AUTH=

# The host address Neo4j's ports are published on. The default, 127.0.0.1, keeps Neo4j on this machine;
# reach it from another one through an SSH tunnel. 0.0.0.0 opens it to your network.
# PUBLISH_ADDRESS=127.0.0.1
