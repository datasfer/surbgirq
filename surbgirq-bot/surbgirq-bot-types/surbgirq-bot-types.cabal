cabal-version:      3.0


name:           surbgirq-bot-types
version:        0.1.0.0
description:    Please see the README on GitHub at <https://github.com/arthurvard/surbgirq-types#readme>
homepage:       https://github.com/arthurvard/surbgirq-bot-types#readme
bug-reports:    https://github.com/arthurvard/surbgirq-bot-types/issues
author:         Arthur Vardanyan
maintainer:     artie.vard@gmail.com
copyright:      2019
license:        MIT
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    ChangeLog.md

source-repository head
  type: git
  location: https://github.com/arthurvard/surbgirq-bot-types

library
  hs-source-dirs: src
  exposed-modules: Surbgirq.Bot.Types
  other-modules: Paths_surbgirq_bot_types
                 Surbgirq.Bot.Types.Config

  build-depends: base >= 4.17.2.1 && < 5
               , surbgirq-types
               , surbgirq-bot-state
               , stm
               , common
               , aeson
               , data-default
               , http-client          
               , telegram-api
               , text
               , containers
               , interpolatedstring-perl6

  default-language: Haskell2010


test-suite surbgirq-bot-types-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules: Paths_surbgirq_bot_types
  hs-source-dirs: test
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends: base >= 4.17.2.1 && < 5
               , surbgirq-types
  default-extensions: TemplateHaskell
                      OverloadedStrings
  default-language: Haskell2010