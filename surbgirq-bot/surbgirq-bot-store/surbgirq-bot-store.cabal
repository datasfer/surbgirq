cabal-version:      3.0

name:           surbgirq-bot-store
version:        0.1.0.0
description:    Please see the README on GitHub at <https://github.com/arthurvard/surbgirq-types#readme>
homepage:       https://github.com/arthurvard/surbgirq-bot-store#readme
bug-reports:    https://github.com/arthurvard/surbgirq-bot-store/issues
author:         Arthur Vardanyan
maintainer:     artie.vard@gmail.com
copyright:      2019
license:        MIT
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    ChangeLog.md

source-repository head
  type: git
  location: https://github.com/arthurvard/surbgirq-bot-store

library
  hs-source-dirs: src
  exposed-modules: Surbgirq.Bot.Store
  other-modules: Paths_surbgirq_bot_store
                 Surbgirq.Bot.Store.Query
                 Surbgirq.Bot.Store.Types
  build-depends: base >= 4.17.2.1 && < 5
               , surbgirq-types
               , surbgirq-bot-state
               , surbgirq-bot-types
               , common
               , aeson
               , data-default
               , text
               , stm
               , mtl
               , containers
               , interpolatedstring-perl6

  default-language: Haskell2010


test-suite surbgirq-bot-store-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules: Paths_surbgirq_bot_store
  hs-source-dirs: test
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends: base >= 4.17.2.1 && < 5
               , surbgirq-types
  default-extensions: TemplateHaskell
                      OverloadedStrings
  default-language: Haskell2010